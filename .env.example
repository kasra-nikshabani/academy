# ==========================================================================
# SEPahan Academy OS — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- app ---
NODE_ENV="development"
APP_URL="http://localhost:3200"

# --- database (docker-compose service `postgres`) ---
POSTGRES_USER="academy"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="academy_dev"
POSTGRES_PORT="5436"
DATABASE_URL="postgresql://academy:change-me@localhost:5436/academy_dev?schema=public"

# --- auth (Phase 2) ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
SESSION_COOKIE_NAME="academy_session"
SESSION_TTL_HOURS="12"

# --- OTP (Phase 2) ---
OTP_TTL_SECONDS="120"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_PER_HOUR="5"
OTP_MAX_PER_IP_PER_HOUR="20"
# "console" writes to the logger in development; a real provider lands later.
SMS_PROVIDER="console"

# --- storage (Phase 18) ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
