# --- dependencies ---
/node_modules
.pnp
.pnp.*
.yarn/*

# --- next.js ---
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# --- production build ---
/build
/dist

# --- environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
/secrets

# --- testing ---
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# --- prisma generated client ---
/lib/generated

# --- uploads (local storage provider) ---
/storage/uploads
/public/uploads

# --- logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs

# --- editors / os ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp
Thumbs.db

# --- agent / editor tooling ---
# Local run configuration for the preview pane. Written per machine (ports and
# commands differ), and the repo deliberately keeps agent tool files out —
# `prisma init` once pulled unvetted instruction files in here.
/.claude

# --- misc ---
.vercel
.turbo

# --- uploaded documents (NEVER commit: real identity papers) ---
/storage/
