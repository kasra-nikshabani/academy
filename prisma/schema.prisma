// SEPahan Academy OS — Prisma schema
//
// Prisma 7 no longer accepts `url` inside `datasource`. The connection string
// comes from prisma7.config.ts (CLI) and from the pg driver adapter in
// lib/db.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — Phase 2
// Roles and permissions arrive in Phase 3; this phase answers "who are you",
// not "what may you do".
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OtpPurpose {
  /// Signing in to an existing account.
  LOGIN
  /// Public tryout registration, where no account exists yet (Phase 10).
  TRYOUT_REGISTRATION
}

model User {
  id     String     @id @default(cuid())
  /// Normalised to `09XXXXXXXXX` before it ever reaches the database.
  mobile String     @unique
  status UserStatus @default(ACTIVE)

  /// Set on every successful OTP verification.
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes  OtpCode[]
  userRoles UserRole[]
  person    Person?
  /// Role assignments this user granted to others — kept for audit.
  grantedRoles UserRole[] @relation("RoleAssignedBy")

  @@index([status])
}

model OtpCode {
  id String @id @default(cuid())

  /// Kept on the row itself: a code may be requested for a number that has no
  /// account, and the rate limiter counts by number regardless of account.
  mobile  String
  purpose OtpPurpose @default(LOGIN)

  /// HMAC-SHA256 of the code, keyed with AUTH_SECRET and bound to the mobile
  /// number. The plaintext code is never stored, logged, or returned.
  codeHash String

  expiresAt  DateTime
  /// Set the moment a code is accepted — a consumed code cannot be replayed.
  consumedAt DateTime?
  /// Wrong guesses against this code; the code dies once the cap is reached.
  attempts   Int       @default(0)

  /// SHA-256 of the requesting IP. Enough to rate-limit a source without
  /// keeping an address that identifies a child's household.
  ipHash String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Drives both "is there a live code for this number" and the per-number
  /// rate limit window.
  @@index([mobile, createdAt])
  @@index([expiresAt])
  @@index([userId])
}


// ---------------------------------------------------------------------------
// Authorization — Phase 3
//
// Two independent questions, never collapsed into one:
//   Permission — may this role perform this kind of action at all?
//   Scope      — is this particular record within the caller's reach?
// Scope predicates that depend on teams and families arrive with their models
// in Phase 5/6; see docs/PERMISSIONS.md.
// ---------------------------------------------------------------------------

enum RoleKey {
  ADMIN
  ACADEMY_MANAGER
  STAFF
  MAIN_TEAM_PLAYER
  SCHOOL_PLAYER
  PARENT
}

model Role {
  id  String  @id @default(cuid())
  key RoleKey @unique
  /// Persian label shown in the interface.
  name        String
  description String?

  /// System roles are seeded and may not be deleted; the six roles the
  /// academy is organised around are structural, not user-created data.
  isSystem Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())
  /// `resource:action`, e.g. `player:read`. Mirrors lib/permissions/catalogue.ts,
  /// which is the source of truth; the seed syncs this table to it.
  key String @unique

  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
}

model UserRole {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  /// Who granted this role. Null for seeded assignments.
  assignedById String?
  assignedBy   User?   @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  /// One user may hold several roles — a coach who is also a player's parent
  /// is ordinary in an academy — but never the same role twice.
  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}


// ---------------------------------------------------------------------------
// Academy structure — Phase 4
//
//   Sport ──┬── AgeGroup ──┐
//           ├── School      ├── Team
//           └──────────────┘
//
// Teams are **not** season-scoped: "Football U14" is the same team from one
// year to the next, and it is the *membership* that carries the season
// (TeamMembership: playerId + teamId + seasonId). Tying the team itself to a
// season would fork the roster history every summer.
// ---------------------------------------------------------------------------

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Sport {
  id String @id @default(cuid())
  /// URL segment for the public pages, e.g. /sports/football
  slug String @unique
  name   String
  nameEn String?

  description String?
  isActive    Boolean @default(true)
  /// Manual ordering in lists; sports are few and rank by importance, not name.
  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ageGroups AgeGroup[]
  schools   School[]
  teams     Team[]

  @@index([isActive, displayOrder])
}

/// An age band within one sport.
///
/// Bands belong to a sport rather than being shared: football runs U12–U21
/// while another sport may band differently, and editing one must not move
/// another sport's boundaries.
///
/// The band is stored as an **age range**, not as birth years. Birth years
/// shift every season — a player who is U14 in 1405 is U16 material in 1407 —
/// so the eligible birth years are derived per season instead of being frozen
/// into the row. See lib/services/age-group.ts.
model AgeGroup {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  /// Short label, e.g. `U14`.
  code String
  /// Persian name, e.g. «نوجوانان».
  name String

  /// Youngest and oldest age admitted, inclusive. `U14` with minAge 12 and
  /// maxAge 13 admits players who turn 12 or 13 in the season year.
  minAge Int
  maxAge Int

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]

  @@unique([sportId, code])
  @@index([sportId, displayOrder])
}

model Season {
  id   String @id @default(cuid())
  /// Display label, e.g. «۱۴۰۴-۱۴۰۵».
  name String @unique

  /// The Jalali year the season starts in. Age groups are computed from this:
  /// a player's age for the season is `startYear − birthYear`, by birth year
  /// alone, which is how youth football bands are drawn
  /// (docs/BUSINESS_RULES.md §4).
  startYear Int

  startDate DateTime
  endDate   DateTime

  status SeasonStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startYear])
}

model School {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  slug String @unique
  name String

  description String?
  city        String?
  address     String?
  phone       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sportId, isActive])
}

model Team {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  ageGroupId String
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)

  slug String @unique
  name String

  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff StaffTeam[]

  @@index([sportId, isActive])
  @@index([ageGroupId])
}


// ---------------------------------------------------------------------------
// People — Phase 5
//
// `Person` is the human. `Player`, `Guardian` and `Staff` are the parts that
// human plays in the academy, and one person can be several of them at once —
// a coach who is also a parent is ordinary here, and this is the same fact
// that made UserRole a table in Phase 3.
//
// Splitting identity from role avoids the alternative: repeating name,
// national code and date of birth on three tables and letting them drift.
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  INJURED
  TRANSFERRED
  RETIRED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

/// Role a staff member holds on a particular team.
enum StaffTeamRole {
  HEAD_COACH
  ASSISTANT_COACH
  GOALKEEPING_COACH
  FITNESS_COACH
  ANALYST
  PHYSIO
  TEAM_MANAGER
  OTHER
}

enum GuardianRelation {
  FATHER
  MOTHER
  GRANDPARENT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

model Person {
  id String @id @default(cuid())

  firstName String
  lastName  String

  /// Ten digits with a valid check digit (lib/validation/iran.ts). Optional
  /// because a child may be registered before the family supplies it, but
  /// unique when present — it is the key that stops the same player being
  /// created twice at tryout registration (BUSINESS_RULES §1).
  nationalCode String? @unique

  /// Stored UTC, rendered Jalali. Age bands read the Jalali birth *year*
  /// from this (BUSINESS_RULES §4).
  dateOfBirth DateTime?
  gender      Gender?

  mobile String?
  email  String?

  city    String?
  address String?

  photoKey String?

  /// The login this person uses, if they have one. A young player may have no
  /// account at all while their guardian does.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   Player?
  guardian Guardian?
  staff    Staff?

  @@index([lastName, firstName])
}

model Player {
  id String @id @default(cuid())

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Club-facing identifier, e.g. `SEP-1405-0007`.
  playerCode String       @unique
  status     PlayerStatus @default(ACTIVE)

  position      String?
  jerseyNumber  Int?
  dominantFoot  String?
  heightCm      Int?
  weightKg      Int?

  /// Free-text medical note. Sensitive: never logged, never in list responses.
  medicalNotes String?

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians PlayerGuardian[]

  @@index([status])
}

model Guardian {
  id String @id @default(cuid())

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players PlayerGuardian[]
}

/// Which adults may see which players.
///
/// This table *is* the parent scope: a guardian reaches exactly the players
/// joined to them here and no others.
model PlayerGuardian {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relation GuardianRelation @default(OTHER)
  /// The adult contacted first. At most one per player, enforced in the service.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([playerId, guardianId])
  @@index([guardianId])
}

model Staff {
  id String @id @default(cuid())

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  status StaffStatus @default(ACTIVE)

  /// Job title as the club words it, e.g. «سرمربی».
  title          String?
  specialization String?
  hiredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams StaffTeam[]

  @@index([status])
}

/// Which teams a staff member is responsible for.
///
/// This table *is* the coach scope: holding `training:write` means nothing
/// until a row here says which teams it applies to (docs/PERMISSIONS.md §5).
model StaffTeam {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role StaffTeamRole @default(OTHER)

  assignedAt DateTime  @default(now())
  /// Set instead of deleting, so past responsibility stays on the record.
  unassignedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([staffId, teamId])
  @@index([teamId])
}
