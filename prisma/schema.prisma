// SEPahan Academy OS — Prisma schema
//
// Prisma 7 no longer accepts `url` inside `datasource`. The connection string
// comes from prisma7.config.ts (CLI) and from the pg driver adapter in
// lib/db.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — Phase 2
// Roles and permissions arrive in Phase 3; this phase answers "who are you",
// not "what may you do".
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OtpPurpose {
  /// Signing in to an existing account.
  LOGIN
  /// Public tryout registration, where no account exists yet (Phase 10).
  TRYOUT_REGISTRATION
}

model User {
  id     String     @id @default(cuid())
  /// Normalised to `09XXXXXXXXX` before it ever reaches the database.
  mobile String     @unique
  status UserStatus @default(ACTIVE)

  /// Set on every successful OTP verification.
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes     OtpCode[]
  userRoles    UserRole[]
  person       Person?
  /// Role assignments this user granted to others — kept for audit.
  grantedRoles UserRole[] @relation("RoleAssignedBy")

  @@index([status])
}

model OtpCode {
  id String @id @default(cuid())

  /// Kept on the row itself: a code may be requested for a number that has no
  /// account, and the rate limiter counts by number regardless of account.
  mobile  String
  purpose OtpPurpose @default(LOGIN)

  /// HMAC-SHA256 of the code, keyed with AUTH_SECRET and bound to the mobile
  /// number. The plaintext code is never stored, logged, or returned.
  codeHash String

  expiresAt  DateTime
  /// Set the moment a code is accepted — a consumed code cannot be replayed.
  consumedAt DateTime?
  /// Wrong guesses against this code; the code dies once the cap is reached.
  attempts   Int       @default(0)

  /// SHA-256 of the requesting IP. Enough to rate-limit a source without
  /// keeping an address that identifies a child's household.
  ipHash String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Drives both "is there a live code for this number" and the per-number
  /// rate limit window.
  @@index([mobile, createdAt])
  @@index([expiresAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Authorization — Phase 3
//
// Two independent questions, never collapsed into one:
//   Permission — may this role perform this kind of action at all?
//   Scope      — is this particular record within the caller's reach?
// Scope predicates that depend on teams and families arrive with their models
// in Phase 5/6; see docs/PERMISSIONS.md.
// ---------------------------------------------------------------------------

enum RoleKey {
  ADMIN
  ACADEMY_MANAGER
  STAFF
  MAIN_TEAM_PLAYER
  SCHOOL_PLAYER
  PARENT
}

model Role {
  id          String  @id @default(cuid())
  key         RoleKey @unique
  /// Persian label shown in the interface.
  name        String
  description String?

  /// System roles are seeded and may not be deleted; the six roles the
  /// academy is organised around are structural, not user-created data.
  isSystem Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id  String @id @default(cuid())
  /// `resource:action`, e.g. `player:read`. Mirrors lib/permissions/catalogue.ts,
  /// which is the source of truth; the seed syncs this table to it.
  key String @unique

  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
}

model UserRole {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt   DateTime @default(now())
  /// Who granted this role. Null for seeded assignments.
  assignedById String?
  assignedBy   User?    @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  /// One user may hold several roles — a coach who is also a player's parent
  /// is ordinary in an academy — but never the same role twice.
  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Academy structure — Phase 4
//
//   Sport ──┬── AgeGroup ──┐
//           ├── School      ├── Team
//           └──────────────┘
//
// Teams are **not** season-scoped: "Football U14" is the same team from one
// year to the next, and it is the *membership* that carries the season
// (TeamMembership: playerId + teamId + seasonId). Tying the team itself to a
// season would fork the roster history every summer.
// ---------------------------------------------------------------------------

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Sport {
  id     String  @id @default(cuid())
  /// URL segment for the public pages, e.g. /sports/football
  slug   String  @unique
  name   String
  nameEn String?

  description  String?
  isActive     Boolean @default(true)
  /// Manual ordering in lists; sports are few and rank by importance, not name.
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ageGroups           AgeGroup[]
  schools             School[]
  teams               Team[]
  tryouts             Tryout[]
  evaluationTemplates EvaluationTemplate[]

  @@index([isActive, displayOrder])
}

/// An age band within one sport.
///
/// Bands belong to a sport rather than being shared: football runs U12–U21
/// while another sport may band differently, and editing one must not move
/// another sport's boundaries.
///
/// The band is stored as an **age range**, not as birth years. Birth years
/// shift every season — a player who is U14 in 1405 is U16 material in 1407 —
/// so the eligible birth years are derived per season instead of being frozen
/// into the row. See lib/services/age-group.ts.
model AgeGroup {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  /// Short label, e.g. `U14`.
  code String
  /// Persian name, e.g. «نوجوانان».
  name String

  /// Youngest and oldest age admitted, inclusive. `U14` with minAge 12 and
  /// maxAge 13 admits players who turn 12 or 13 in the season year.
  minAge Int
  maxAge Int

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams               Team[]
  tryouts             Tryout[]
  evaluationTemplates EvaluationTemplate[]

  @@unique([sportId, code])
  @@index([sportId, displayOrder])
}

model Season {
  id   String @id @default(cuid())
  /// Display label, e.g. «۱۴۰۴-۱۴۰۵».
  name String @unique

  /// The Jalali year the season starts in. Age groups are computed from this:
  /// a player's age for the season is `startYear − birthYear`, by birth year
  /// alone, which is how youth football bands are drawn
  /// (docs/BUSINESS_RULES.md §4).
  startYear Int

  startDate DateTime
  endDate   DateTime

  status SeasonStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolEnrollments SchoolEnrollment[]
  teamMemberships   TeamMembership[]
  trainingSessions  TrainingSession[]
  tryouts           Tryout[]
  matches           Match[]
  announcements     Announcement[]

  @@index([status])
  @@index([startYear])
}

model School {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  slug String @unique
  name String

  description String?
  city        String?
  address     String?
  phone       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   SchoolEnrollment[]
  announcements Announcement[]

  @@index([sportId, isActive])
}

model Team {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  ageGroupId String
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)

  slug String @unique
  name String

  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff       StaffTeam[]
  memberships TeamMembership[]

  trainingPlans    TrainingPlan[]
  trainingSessions TrainingSession[]
  matches          Match[]
  announcements    Announcement[]

  @@index([sportId, isActive])
  @@index([ageGroupId])
}

// ---------------------------------------------------------------------------
// People — Phase 5
//
// `Person` is the human. `Player`, `Guardian` and `Staff` are the parts that
// human plays in the academy, and one person can be several of them at once —
// a coach who is also a parent is ordinary here, and this is the same fact
// that made UserRole a table in Phase 3.
//
// Splitting identity from role avoids the alternative: repeating name,
// national code and date of birth on three tables and letting them drift.
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  INJURED
  TRANSFERRED
  RETIRED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

/// Role a staff member holds on a particular team.
enum StaffTeamRole {
  HEAD_COACH
  ASSISTANT_COACH
  GOALKEEPING_COACH
  FITNESS_COACH
  ANALYST
  PHYSIO
  TEAM_MANAGER
  OTHER
}

enum GuardianRelation {
  FATHER
  MOTHER
  GRANDPARENT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

model Person {
  id String @id @default(cuid())

  firstName String
  lastName  String

  /// Ten digits with a valid check digit (lib/validation/iran.ts). Optional
  /// because a child may be registered before the family supplies it, but
  /// unique when present — it is the key that stops the same player being
  /// created twice at tryout registration (BUSINESS_RULES §1).
  nationalCode String? @unique

  /// Stored UTC, rendered Jalali. Age bands read the Jalali birth *year*
  /// from this (BUSINESS_RULES §4).
  dateOfBirth DateTime?
  gender      Gender?

  mobile String?
  email  String?

  city    String?
  address String?

  photoKey String?

  /// The login this person uses, if they have one. A young player may have no
  /// account at all while their guardian does.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   Player?
  guardian Guardian?
  staff    Staff?

  notifications Notification[]
  documents     Document[]

  @@index([lastName, firstName])
}

model Player {
  id String @id @default(cuid())

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Club-facing identifier, e.g. `SEP-1405-0007`.
  playerCode String       @unique
  status     PlayerStatus @default(ACTIVE)

  position     String?
  jerseyNumber Int?
  dominantFoot String?
  heightCm     Int?
  weightKg     Int?

  /// Free-text medical note. Sensitive: never logged, never in list responses.
  medicalNotes String?

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians          PlayerGuardian[]
  schoolEnrollments  SchoolEnrollment[]
  teamMemberships    TeamMembership[]
  journeyEvents      PlayerJourneyEvent[]
  attendance         Attendance[]
  tryoutApplications TryoutApplication[]
  evaluations        Evaluation[]
  matchLineups       MatchLineup[]
  matchStats         PlayerMatchStat[]
  performanceRecords PerformanceRecord[]

  @@index([status])
}

model Guardian {
  id String @id @default(cuid())

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players PlayerGuardian[]
}

/// Which adults may see which players.
///
/// This table *is* the parent scope: a guardian reaches exactly the players
/// joined to them here and no others.
model PlayerGuardian {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relation  GuardianRelation @default(OTHER)
  /// The adult contacted first. At most one per player, enforced in the service.
  isPrimary Boolean          @default(false)

  createdAt DateTime @default(now())

  @@unique([playerId, guardianId])
  @@index([guardianId])
}

model Staff {
  id String @id @default(cuid())

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  status StaffStatus @default(ACTIVE)

  /// Job title as the club words it, e.g. «سرمربی».
  title          String?
  specialization String?
  hiredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams       StaffTeam[]
  evaluations Evaluation[]

  @@index([status])
}

/// Which teams a staff member is responsible for.
///
/// This table *is* the coach scope: holding `training:write` means nothing
/// until a row here says which teams it applies to (docs/PERMISSIONS.md §5).
model StaffTeam {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role StaffTeamRole @default(OTHER)

  assignedAt   DateTime  @default(now())
  /// Set instead of deleting, so past responsibility stays on the record.
  unassignedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([staffId, teamId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Enrollment — Phase 6
//
// Two independent relationships, deliberately not nested:
//   SchoolEnrollment — a player attends a sports school in a season
//   TeamMembership   — a player belongs to a squad in a season
//
// A player can hold both at once. Being accepted into a main team does **not**
// end a school enrolment; only a manager's explicit action does
// (BUSINESS_RULES §2).
// ---------------------------------------------------------------------------

enum EnrollmentStatus {
  PENDING
  ACTIVE
  TRANSFERRED
  COMPLETED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  RELEASED
}

model SchoolEnrollment {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  status EnrollmentStatus @default(PENDING)

  enrolledAt DateTime  @default(now())
  /// Set when the enrolment ends. The row is never deleted — a player's
  /// history of which schools they attended is the record (CLAUDE.md §2).
  endedAt    DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, schoolId, seasonId])
  @@index([schoolId, status])
  @@index([seasonId])
}

model TeamMembership {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  status MembershipStatus @default(ACTIVE)

  /// A player may belong to more than one squad in a season — training up an
  /// age group is ordinary in youth football — but exactly one membership per
  /// season is the primary one, so attendance and reporting have an
  /// unambiguous home team. Enforced in the service, transactionally.
  isPrimary Boolean @default(false)

  /// Squad number within this team, when the club assigns one.
  jerseyNumber Int?

  joinedAt DateTime  @default(now())
  /// Set when the player leaves. The row stays as history.
  leftAt   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, teamId, seasonId])
  @@index([teamId, status])
  @@index([seasonId])
  @@index([playerId, seasonId])
}

// ---------------------------------------------------------------------------
// Journey — Phase 7
//
// The record of what happened to a player, in order.
//
// Append-only: rows are never edited or deleted. An event is a statement that
// something occurred, and a timeline that can be rewritten is not a record of
// anything. Corrections are made by adding a further event.
//
// Every event is written in the same transaction as the fact it describes, so
// there can be no membership without its event and no event without its
// membership (lib/repositories/transaction.ts).
// ---------------------------------------------------------------------------

enum JourneyEventType {
  REGISTERED
  SCHOOL_JOINED
  TRYOUT_REGISTERED
  TRYOUT_ACCEPTED
  TRYOUT_REJECTED
  EVALUATION
  TEAM_JOINED
  TEAM_LEFT
  PROMOTED
  TRANSFERRED
  ACHIEVEMENT
  OTHER
}

model PlayerJourneyEvent {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  type JourneyEventType

  /// When it happened, which is not always when it was recorded.
  occurredAt DateTime @default(now())

  /// One Persian line for the timeline.
  title       String
  description String?

  /// What the event was about. Left as loose ids rather than relations: the
  /// event must survive the team or school being deactivated later.
  seasonId String?
  teamId   String?
  schoolId String?

  /// Who caused it. Null for anything the system recorded on its own.
  actorId String?

  createdAt DateTime @default(now())

  @@index([playerId, occurredAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Training — Phase 8
//
//   TrainingPlan ──< TrainingExercise
//        │
//        └──< TrainingSession >── Team, Season
//
// **A session belongs to exactly one team.** A joint session between two age
// groups is recorded as two sessions at the same hour, not one session with
// two teams. Attendance, the coach's scope and every squad report all resolve
// through "which team is this?", and a session with two answers makes each of
// them ambiguous for the sake of one row (docs/BUSINESS_RULES.md §7).
//
// A plan is **planning material, not a record of what happened.** It is
// reusable across sessions and stays editable; what a session actually was is
// carried by its own status, notes and — from Phase 9 — its attendance.
// ---------------------------------------------------------------------------

enum TrainingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TrainingType {
  TECHNICAL
  PHYSICAL
  TACTICAL
  RECOVERY
  MIXED
  OTHER
}

/// A reusable training programme: an ordered set of exercises.
model TrainingPlan {
  id String @id @default(cuid())

  /// The team this plan was written for. Null means it is available to every
  /// team — a fitness block the whole academy runs, for instance.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        TrainingType @default(MIXED)

  isActive Boolean @default(true)

  /// Who wrote it. A loose id rather than a relation, matching the journey:
  /// the plan must outlive changes to the account that created it.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises TrainingExercise[]
  sessions  TrainingSession[]

  @@index([teamId, isActive])
}

/// One exercise inside a plan.
model TrainingExercise {
  id String @id @default(cuid())

  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Position within the plan. Named like the rest of the schema rather than
  /// `order`, which is a reserved word in SQL and reads badly in raw queries.
  displayOrder Int @default(0)

  title       String
  description String?

  /// Minutes on the pitch for this exercise; the plan's total is their sum.
  durationMinutes Int?
  /// What it trains, in the coach's own words, e.g. «کنترل توپ».
  focus           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, displayOrder])
}

/// A training session in the calendar.
model TrainingSession {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  /// The season the session falls in, resolved from its date rather than from
  /// whichever season happened to be active when it was entered — a
  /// pre-season session typed in June belongs to the season it is played in.
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  /// The plan the session follows, if any. `SetNull` because deleting a plan
  /// must not take the session with it.
  planId String?
  plan   TrainingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  type   TrainingType   @default(MIXED)
  status TrainingStatus @default(SCHEDULED)

  /// Stored UTC, shown Jalali in Tehran time. `endsAt` is derived from the
  /// duration the caller gives and kept on the row so an overlap can be
  /// answered by the database instead of in application code.
  startsAt DateTime
  endsAt   DateTime

  location     String?
  notes        String?
  /// Why a cancelled session was cancelled. Cancelling never deletes the row.
  cancelReason String?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance         Attendance[]
  evaluations        Evaluation[]
  performanceRecords PerformanceRecord[]

  /// There is deliberately **no** unique key on `teamId + startsAt`.
  ///
  /// It looks like the obvious backstop for a double booking, and it was here
  /// until a test caught what it really does: a cancelled session frees its
  /// slot, so re-entering a session at the same hour is legitimate and the
  /// constraint refused it. A rule with an exception is not a unique key. The
  /// clash check lives in the service, under a per-team advisory lock, which
  /// covers the race the constraint was there for
  /// (lib/repositories/training.repository.ts).
  @@index([teamId, startsAt])
  @@index([startsAt])
  @@index([seasonId])
  @@index([status, startsAt])
}

// ---------------------------------------------------------------------------
// Attendance — Phase 9
//
// One row per player per session. The coach marks the whole squad present and
// then corrects the exceptions, which is how attendance is actually taken at
// the side of a pitch (CLAUDE.md §15).
//
// Who may see what splits here, and the split is the point of this module:
// the **sheet** belongs to the coach, the **row** belongs to the player. A
// parent reads their own child's attendance and never learns which other
// child was absent (docs/PRODUCT_SPEC.md §8).
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Attendance {
  id String @id @default(cuid())

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  status AttendanceStatus

  /// Only meaningful with `LATE`; the service clears it for every other status
  /// rather than leaving a stale number attached to a player who was present.
  minutesLate Int?

  /// Why, in the coach's words — the reason an absence was excused, or a note
  /// about the session. Not a medical record; nothing sensitive belongs here.
  note String?

  /// Who took the register, and when it was actually taken — which is not the
  /// session's own time, and is what tells a register filled in a week later
  /// from one filled in on the pitch.
  recordedById String?
  recordedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A player is either at a session or not; there is no second answer.
  @@unique([trainingSessionId, playerId])
  @@index([playerId, recordedAt])
  @@index([trainingSessionId, status])
}

// ---------------------------------------------------------------------------
// Talent — Phase 10
//
//   Tryout ──< TryoutApplication ──1 Screening
//
// The public half of the academy: anyone may register for a trial without an
// account, proving only that they hold the phone number they gave.
//
// **An applicant who is already in the academy keeps their record.** A school
// player trying out for a main team is the ordinary case, not an edge one, and
// creating a second `Person` for them would fork their history at exactly the
// moment it becomes interesting (BUSINESS_RULES §1).
// ---------------------------------------------------------------------------

enum TryoutStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  EVALUATION
  ACCEPTED
  REJECTED
  WAITLIST
  CANCELLED
}

enum ScreeningStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tryout {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Restrict)

  /// The band being trialled. Required: a trial without an age band cannot
  /// check whether an applicant is eligible, and "we will sort it out later"
  /// is how a nine-year-old ends up on an under-18 list.
  ageGroupId String
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  /// URL segment for the public page, e.g. /tryouts/u14-isfahan-1405
  slug        String  @unique
  title       String
  description String?

  city  String?
  venue String?

  /// When registration is open. Outside this window the form is closed even
  /// if someone keeps the page open.
  opensAt  DateTime
  closesAt DateTime
  /// When the trial is actually held, once it is known.
  heldAt   DateTime?

  /// Places available, when the club has set a limit. Null means unlimited.
  capacity Int?

  status TryoutStatus @default(DRAFT)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications TryoutApplication[]

  @@index([status, opensAt])
  @@index([sportId, seasonId])
}

model TryoutApplication {
  id String @id @default(cuid())

  tryoutId String
  tryout   Tryout @relation(fields: [tryoutId], references: [id], onDelete: Restrict)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// What the applicant is given to follow their application with. Public, so
  /// it carries no personal information and is never guessable in sequence.
  trackingCode String @unique

  status ApplicationStatus @default(SUBMITTED)

  /// What the applicant said about themselves **at the time**. Kept on the
  /// application rather than only on the player: a trial is judged against
  /// what was claimed then, and the player record moves on.
  position     String?
  dominantFoot String?
  heightCm     Int?
  weightKg     Int?
  previousClub String?
  notes        String?

  submittedAt DateTime @default(now())

  /// The decision, once there is one.
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screening   Screening?
  evaluations Evaluation[]

  /// One application per player per trial (CLAUDE.md §9).
  @@unique([tryoutId, playerId])
  @@index([tryoutId, status])
  @@index([playerId])
}

/// The paperwork check that happens before anyone watches the player play.
model Screening {
  id String @id @default(cuid())

  applicationId String            @unique
  application   TryoutApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status ScreeningStatus @default(PENDING)

  /// The two things actually being checked, kept apart so a rejection can say
  /// which one failed rather than leaving the family to guess.
  ageEligible       Boolean?
  documentsComplete Boolean?

  note String?

  checkedById String?
  checkedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Evaluation — Phase 11
//
//   EvaluationTemplate ──< EvaluationCriterion
//           │                      │
//           └──< Evaluation ──< EvaluationScore
//
// The engine is configurable because a goalkeeper is not judged on the same
// things as a winger, and a volleyball academy on neither (CLAUDE.md §14).
// What stays fixed is the four dimensions the club reports on.
//
// **An evaluation is a record, not a working document.** Once submitted, its
// scores and its computed overall are frozen — a template whose weights change
// next season must not silently restate what a coach concluded last season.
// This is the opposite of `TrainingPlan`, and deliberately so
// (docs/BUSINESS_RULES.md §16).
// ---------------------------------------------------------------------------

/// The four things the club reports on, whatever the criteria underneath.
enum EvaluationDimension {
  TECHNICAL
  PHYSICAL
  MENTAL
  OVERALL
}

enum EvaluationStatus {
  /// Assigned to an evaluator, or being filled in.
  DRAFT
  /// Finished. Scores and the overall are frozen from here.
  SUBMITTED
}

/// What the evaluator advises. Deliberately **not** a decision: a coach
/// recommends, the academy manager decides (docs/PERMISSIONS.md §5).
enum EvaluationRecommendation {
  ACCEPT
  WAITLIST
  REJECT
  MORE_OBSERVATION
}

model EvaluationTemplate {
  id String @id @default(cuid())

  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Restrict)

  /// Narrows the template to one band when the club wants different criteria
  /// for under-12s than for under-21s. Null means it serves the whole sport.
  ageGroupId String?
  ageGroup   AgeGroup? @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)

  title       String
  description String?

  isActive Boolean @default(true)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria    EvaluationCriterion[]
  evaluations Evaluation[]

  @@index([sportId, isActive])
}

model EvaluationCriterion {
  id String @id @default(cuid())

  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  dimension EvaluationDimension

  title       String
  description String?

  /// Highest score this criterion accepts. Ten by default, because a coach
  /// marking out of ten needs no explanation.
  maxScore Int @default(10)

  /// How much this criterion counts toward the overall. Equal by default; a
  /// club that thinks first touch matters twice as much can say so.
  weight Int @default(1)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores EvaluationScore[]

  @@index([templateId, displayOrder])
}

model Evaluation {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// The staff member who is to fill this in. **This is the coach's route to
  /// a trial player**: they are given the evaluation, not the application, so
  /// they never need a `tryout:*` permission to do their job.
  evaluatorId String
  evaluator   Staff  @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  /// Who asked for it. Null when a coach evaluates their own squad unprompted.
  assignedById String?

  /// What the evaluation was for. Both optional, so an evaluation can stand on
  /// its own — a coach assessing a squad player in January answers to nothing
  /// but the calendar.
  applicationId String?
  application   TryoutApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  trainingSessionId String?
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  status EvaluationStatus @default(DRAFT)

  /// The weighted average, computed once at submission and then left alone.
  /// Stored rather than derived so that editing a template next season cannot
  /// rewrite what a coach concluded this one.
  overallScore Float?

  recommendation EvaluationRecommendation?

  strengths  String?
  weaknesses String?
  notes      String?

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores EvaluationScore[]

  @@index([playerId, submittedAt])
  @@index([evaluatorId, status])
  @@index([applicationId])
}

model EvaluationScore {
  id String @id @default(cuid())

  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  criterionId String
  criterion   EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  score Int

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One score per criterion per evaluation (CLAUDE.md §9).
  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

// ---------------------------------------------------------------------------
// Competition — Phase 13
//
//   Match ──< MatchLineup      (who was picked)
//         └─< PlayerMatchStat  (what they did)
//
// Two tables keyed the same way on purpose. Selection happens before the
// whistle and stats after it, and a player can be named on the sheet and never
// come on — an unused substitute is a lineup row with no stat row, which is
// exactly the truth of that afternoon (CLAUDE.md §9).
//
// **Only the squad plays.** A lineup may name a player who belongs to this
// team in this season and nobody else. Without that a coach could file match
// statistics against any player in the academy, and the row would look every
// bit as legitimate as a real one (docs/BUSINESS_RULES.md §18) — the same
// rule, for the same reason, as the attendance register.
//
// The opponent is free text. Other clubs are not in this database and
// modelling them would mean maintaining a directory of every youth side in
// the province to write "سپاهان ب" on a fixture.
// ---------------------------------------------------------------------------

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum HomeAway {
  HOME
  AWAY
  NEUTRAL
}

/// Whether a player started, came on, or sat.
enum LineupRole {
  STARTER
  SUBSTITUTE
}

model Match {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  /// Resolved from the kick-off date, not from whichever season is active —
  /// a pre-season friendly entered in June belongs to the season it is played
  /// in. Same rule as a training session.
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  /// The other side, as the club writes it on the fixture list.
  opponent    String
  /// League, cup, friendly — free text, because what counts as a competition
  /// differs by sport and by season and is not ours to enumerate.
  competition String?

  homeAway HomeAway @default(HOME)
  venue    String?

  /// Stored UTC, shown Jalali in Tehran time. `endsAt` is derived from the
  /// duration so a clash can be answered by the database, exactly as for
  /// training.
  kickoffAt DateTime
  endsAt    DateTime

  status MatchStatus @default(SCHEDULED)

  /// **Ours and theirs**, rather than home and away. A score kept as
  /// home/away has to be read together with `homeAway` to know who won, and
  /// that is one join too many between a number and its meaning.
  goalsFor     Int?
  goalsAgainst Int?

  notes        String?
  /// Why a cancelled or postponed fixture did not happen.
  cancelReason String?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineup MatchLineup[]
  stats  PlayerMatchStat[]

  /// No unique key on `teamId + kickoffAt`, for the same reason as
  /// `TrainingSession`: a cancelled fixture frees its slot, and a rule with an
  /// exception is not a unique key. The clash check lives in the service under
  /// a per-team advisory lock.
  @@index([teamId, kickoffAt])
  @@index([kickoffAt])
  @@index([seasonId])
  @@index([status, kickoffAt])
}

model MatchLineup {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  role LineupRole @default(STARTER)

  /// The number on the back that day, which is not always the squad number.
  shirtNumber Int?
  /// Where they played in this match, which is not always their usual post.
  position    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A player is named once on a team sheet (CLAUDE.md §9).
  @@unique([matchId, playerId])
  @@index([matchId, role])
}

model PlayerMatchStat {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Zero is a real answer — an unused substitute who is recorded played no
  /// minutes — which is why this is not nullable.
  minutesPlayed Int @default(0)

  goals   Int @default(0)
  assists Int @default(0)

  yellowCards Int @default(0)
  redCards    Int @default(0)

  notes String?

  recordedById String?
  recordedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One line per player per match (CLAUDE.md §9).
  @@unique([matchId, playerId])
  @@index([playerId, recordedAt])
}

// ---------------------------------------------------------------------------
// Performance — Phase 14
//
//   Player ──< PerformanceRecord   (one measurement: a metric, a value, a day)
//
// **A fixed set of metrics, not a configurable one.** The evaluation engine is
// deliberately configurable — a coach's judgement of "first touch" is an
// opinion, and a club may weigh opinions however it likes. A measurement is
// not an opinion. A trend line only means anything when every point on it was
// produced by the same test, in the same unit, the same way; two clubs' custom
// "speed" metrics cannot be drawn on one axis, and neither can two seasons' of
// one club's (docs/BUSINESS_RULES.md §19).
//
// So the metric list lives in an enum, and everything a metric *knows about
// itself* — its Persian label, its unit, its plausible range, how many
// decimals it is read to, and **which direction counts as improvement** —
// lives in one code catalogue, `lib/services/performance-metrics.ts`. That
// catalogue is the reason there is no `unit` or `category` column here: they
// are properties of the metric, not of the measurement, and a copy per row is
// a copy that can disagree with itself.
// ---------------------------------------------------------------------------

/// The tests the academy records. Adding one is an enum value plus a line in
/// the catalogue — never a new column.
enum PerformanceMetric {
  /// Height in centimetres.
  HEIGHT_CM
  /// Weight in kilograms.
  WEIGHT_KG
  /// Flying 20-metre sprint, in seconds. Lower is better.
  SPRINT_20M_S
  /// 5-0-5 change-of-direction test, in seconds. Lower is better.
  AGILITY_505_S
  /// Countermovement vertical jump, in centimetres.
  VERTICAL_JUMP_CM
  /// Twelve-minute Cooper test, in metres.
  COOPER_TEST_M
}

model PerformanceRecord {
  id String @id @default(cuid())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  metric PerformanceMetric

  /// Float because half a centimetre and a hundredth of a second are both real
  /// answers. What counts as a sane value is the catalogue's business, checked
  /// on the way in — a 20-metre sprint of 45 seconds and a Cooper test of four
  /// metres are each impossible, and one global range cannot say so.
  value Float

  /// **Midnight in Tehran on the day of the test**, not the moment the row was
  /// typed. A measurement belongs to the session it was taken at, which is
  /// often entered days later, and a trend drawn against data-entry time is a
  /// trend of the coach's paperwork.
  measuredAt DateTime

  /// The session it was taken at, when it was taken at one. Optional: a growth
  /// check at the start of a term answers to the calendar, not to a session.
  trainingSessionId String?
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  notes String?

  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// **One value per metric per player per day.** Unlike the training clash,
  /// this rule has no exception to express, so it is a real unique key and the
  /// database keeps it. Re-submitting the same day corrects the reading rather
  /// than appending a second one — two different Cooper results dated the same
  /// afternoon do not make a trend, they make it unreadable.
  @@unique([playerId, metric, measuredAt])
  @@index([playerId, metric, measuredAt])
  @@index([measuredAt])
}

// ---------------------------------------------------------------------------
// Communication — Phase 15
//
//   Announcement ──< Notification >── Person
//
// **A notification is addressed to a `Person`, not to a `User`.**
//
// That is the whole design, and it came from the rule this phase finally
// completes. Accepting a trial applicant must tell the family
// (docs/BUSINESS_RULES.md §3) — and a family that applied to a trial has **no
// account**. Public registration creates a `Person` for the child and a
// `Person` for the guardian, with a mobile number and nothing else; the login
// comes later, if they are accepted. Addressing notifications to `User` would
// mean the one message the academy most needs to deliver has no recipient.
//
// `Person` already said so: "A young player may have no account at all while
// their guardian does."
//
// So a notification waits on the person. Someone with a login reads it in
// their panel; someone without has it waiting for the day they sign in, and
// their mobile is on the same row for whenever the club connects a real SMS
// gateway.
//
// There is deliberately **no `channel` column**. A notification is a record of
// something that happened, not a message on a wire — and delivery already has
// its own home in `lib/sms`, kept separate since Phase 2. A column with one
// possible value buys nothing that a migration could not add the day a second
// one exists (docs/PRODUCT_SPEC.md §10).
// ---------------------------------------------------------------------------

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
  TRAINING
  MATCH
  ATTENDANCE
  EVALUATION
  TRYOUT
  SYSTEM
}

model Notification {
  id String @id @default(cuid())

  /// Who it is for. `Person`, not `User` — see the note above.
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  type NotificationType @default(INFO)

  title String
  body  String?

  /// Where it points, as a path inside the app (`/dashboard/...`). Relative so
  /// a stored link can never send a reader to another host.
  link String?

  /// Null until read. A timestamp rather than a boolean, because "when did
  /// they see this" is a question that gets asked and a boolean cannot answer.
  readAt DateTime?

  /// The announcement this was fanned out from, if it came from one. Null for
  /// the ones the system raises by itself.
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  /// The user whose action caused it. Null when nobody in particular did.
  actorId String?

  createdAt DateTime @default(now())

  /// The inbox query: one person's notifications, newest first.
  @@index([personId, createdAt])
  /// The unread badge, which every signed-in page asks for.
  @@index([personId, readAt])
  @@index([announcementId])
}

/// Draft until someone means it. Publishing is what fans it out, and it
/// happens once — there is no unpublishing a message people have already read.
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model Announcement {
  id String @id @default(cuid())

  title String
  body  String

  type NotificationType @default(INFO)

  /// The audience, narrowest wins. A team announcement reaches that squad and
  /// their guardians; a school announcement reaches everyone enrolled there
  /// and theirs; neither set means the whole academy.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Pins a team or school audience to one season. Null means the active one
  /// at the moment of publishing, resolved then and not re-resolved later.
  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?
  /// How many people it reached, frozen at publication. Counting the rows back
  /// later would give a different answer as squads change.
  recipients  Int                @default(0)

  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([status, publishedAt])
  @@index([teamId])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Documents — Phase 18
//
//   Person ──< Document
//
// **Attached to a `Person`, not a `Player`.** A guardian's identity document,
// a coach's contract and a child's birth certificate are the same kind of
// record about three different kinds of people, and `Person` is what they all
// are — the same reasoning that put notifications there in Phase 15.
//
// The row holds everything *about* the file and none of the file: the bytes
// live behind `lib/storage`, which is local disk today and object storage
// later without this table changing.
//
// ## What is trusted here, and what is not
//
// `contentType` is what the **bytes** turned out to be, decided by
// `lib/storage/signature.ts` — never the header the browser sent.
// `storageKey` is a random key this system generated. `originalName` is the
// only field that came from the uploader, it is a label, and it is never
// joined to a path.
// ---------------------------------------------------------------------------

enum DocumentType {
  ID_DOCUMENT
  BIRTH_CERTIFICATE
  CONTRACT
  MEDICAL
  PARENT_CONSENT
  PHOTO
  OTHER
}

model Document {
  id String @id @default(cuid())

  /// Whose document it is.
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  type DocumentType @default(OTHER)

  /// Where the bytes are. Generated, never derived from the upload
  /// (lib/storage/keys.ts). Unique because a key is used once.
  storageKey String @unique

  /// What the file actually is, read from its leading bytes.
  contentType String
  sizeBytes   Int

  /// The name the file arrived with — shown to a person, never a path.
  originalName String

  title String?
  notes String?

  uploadedById String?

  /// Archived rather than deleted. A consent form that was withdrawn is a
  /// thing that happened, and the club may need to show it did
  /// (CLAUDE.md §2). The bytes go when the row is finally purged, which is a
  /// deliberate act and not this.
  archivedAt   DateTime?
  archivedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The list on a person's record: their documents, newest first.
  @@index([personId, archivedAt, createdAt])
  @@index([type])
}
